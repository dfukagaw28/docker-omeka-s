# Generated from deploy/quadlet/omeka-iipsrv.container.in by deploy/install-quadlet.sh
# Installed only when ENABLE_IIPSRV=true in .env
[Unit]
Description=IIPImage server for Omeka S

[Container]
ContainerName=${PREFIX}-iipsrv
# https://github.com/dfukagaw28/docker-iipsrv
Image=ghcr.io/dfukagaw28/iipsrv:${IIPSRV_VERSION}
Network=omeka.network
PublishPort=127.0.0.1:${IIPSRV_PORT}:80
Volume=${IIIF_IMAGE_DIR}:/data/images:ro,z
Environment=MAX_IMAGE_CACHE_SIZE=${IIPSRV_CACHE_MB}
Environment=BASE_URL=${IIPSRV_BASE_URL}

[Service]
Restart=always

[Install]
WantedBy=default.target
