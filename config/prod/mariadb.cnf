# MariaDB settings for the production server (plenty of memory).
# innodb_buffer_pool_size is the main knob: make it larger than the data set
# (see README for how to check its size). Smaller servers, e.g. about 2 GB of
# RAM for Omeka: 512M.
[mysqld]
innodb_buffer_pool_size = 4G
max_connections         = 150
skip-name-resolve
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci
