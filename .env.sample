# Copy to .env and edit. Keep .env private (chmod 600).
# Write values without quotes. DB_NAME / DB_USER / DB_PASSWORD may only use
# A-Z a-z 0-9 . _ @ + - (they are also written into systemd units).

# ---- Environment -------------------------------------------------------
# Per-server settings for MariaDB / PHP: ./config/test or ./config/prod
CONFIG_DIR=./config/test
TZ=Asia/Tokyo

# ---- Versions ----------------------------------------------------------
OMEKA_VERSION=4.2.1
PHP_VERSION=8.5
MARIADB_VERSION=11.8
IIPSRV_VERSION=latest

# ---- Ports (published on 127.0.0.1 only) -------------------------------
OMEKA_PORT=8001
IIPSRV_PORT=8002

# ---- Database ----------------------------------------------------------
DB_NAME=omeka
DB_USER=omeka
DB_PASSWORD=change-me

# ---- Omeka S (used only on the first start) ----------------------------
OMEKA_TITLE=Omeka S
OMEKA_ADMIN_NAME=Admin
OMEKA_ADMIN_EMAIL=admin@example.com
OMEKA_ADMIN_PASSWORD=change-me-too
OMEKA_LOCALE=ja

# ---- Omeka S runtime ---------------------------------------------------
# Long side (px) of the "large" derivative Omeka creates on upload.
OMEKA_THUMB_LARGE=1600
# Write Omeka's application log to the container log (podman logs / journalctl)
OMEKA_LOG=false

# Cap ImageMagick when creating derivatives, so large scans do not exhaust
# memory (test server: 256MiB / 512MiB; production can be raised or removed).
MAGICK_MEMORY_LIMIT=256MiB
MAGICK_MAP_LIMIT=512MiB

# ---- IIPImage (compose profile "iiif") ---------------------------------
# For deploy/install-quadlet.sh: also install the IIPImage service
ENABLE_IIPSRV=false
# Directory with pyramidal TIFFs served at /iiif/<file>/info.json
IIIF_IMAGE_DIR=./data/ptif
# Public URL of the IIPImage endpoint as exposed by Caddy (trailing slash),
# e.g. https://omeka.example.org/iiif-ptif/  ->  .../iiif-ptif/<file>.tif/info.json
IIPSRV_BASE_URL=
# In-memory tile cache (MB)
IIPSRV_CACHE_MB=10
